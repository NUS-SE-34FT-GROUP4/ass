<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Spring Boot 3.5 runs on Java 17 -->
        <version>3.5.16</version> <relativePath/>
    </parent>
    <groupId>sg.edu.nus.iss</groupId>
    <artifactId>c2c-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>c2csectrade</name>
    <description>c2csectrade - Intelligent Second-hand Goods Trading Platform with AI Recommendations</description>

    <!--
      One module per deployable service plus the code they share.
      common holds only what every service needs and no business tables:
      event contracts, JWT handling and error conventions.
    -->
    <modules>
        <module>common</module>
        <module>core</module>
        <module>search</module>
        <module>chat</module>
    </modules>

    <properties>
        <!-- Default to Java 17 for maximum compatibility (Lombok + toolchain) -->
        <java.version>17</java.version>
        <jacoco.version>0.8.14</jacoco.version>
        <!-- Reviewed Bearer-header authentication only; no cookie/session authentication.
             Re-review these exact-file exceptions if authentication changes. CORS is NOT excluded. -->
        <sonar.issue.ignore.multicriteria>coreCsrf,chatCsrf</sonar.issue.ignore.multicriteria>
        <sonar.issue.ignore.multicriteria.coreCsrf.ruleKey>java:S4502</sonar.issue.ignore.multicriteria.coreCsrf.ruleKey>
        <sonar.issue.ignore.multicriteria.coreCsrf.resourceKey>**/sg/edu/nus/iss/c2csectrade/config/SecurityConfig.java</sonar.issue.ignore.multicriteria.coreCsrf.resourceKey>
        <sonar.issue.ignore.multicriteria.chatCsrf.ruleKey>java:S4502</sonar.issue.ignore.multicriteria.chatCsrf.ruleKey>
        <sonar.issue.ignore.multicriteria.chatCsrf.resourceKey>**/sg/edu/nus/iss/c2csectrade/chat/config/SecurityConfig.java</sonar.issue.ignore.multicriteria.chatCsrf.resourceKey>
        <!-- Temporary Chat copies from PR #31: remove each entry when consolidated into common.
             Exact files only; new security classes remain included. See docs/sonar-exceptions.md. -->
        <sonar.cpd.exclusions>**/sg/edu/nus/iss/c2csectrade/chat/entity/User.java,**/sg/edu/nus/iss/c2csectrade/chat/security/JwtAuthenticationFilter.java,**/sg/edu/nus/iss/c2csectrade/chat/security/UserDetailsImpl.java,**/sg/edu/nus/iss/c2csectrade/chat/security/UserDetailsServiceImpl.java,**/sg/edu/nus/iss/c2csectrade/chat/config/SecurityConfig.java,**/sg/edu/nus/iss/c2csectrade/chat/config/RabbitMQConfig.java,**/sg/edu/nus/iss/c2csectrade/chat/mapper/UserMapper.java</sonar.cpd.exclusions>
        <jjwt.version>0.11.5</jjwt.version>
        <!-- Patch releases ahead of what Boot 3.5.16 manages, each fixing a
             CRITICAL CVE that the Trivy gate in CI fails on. Drop an override
             once Boot's own managed version reaches it. -->
        <tomcat.version>10.1.60</tomcat.version>
        <netty.version>4.1.139.Final</netty.version>
        <bouncycastle.version>1.86</bouncycastle.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>sg.edu.nus.iss</groupId>
                <artifactId>c2c-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- Pulled in by MinIO 8.5.7 at 1.76 -->
            <dependency>
                <groupId>org.bouncycastle</groupId>
                <artifactId>bcprov-jdk18on</artifactId>
                <version>${bouncycastle.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>coverage-agent</id>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>coverage-report</id>
                        <phase>verify</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.12.0</version>
                <configuration>
                    <source>${java.version}</source>
                    <target>${java.version}</target>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Optional profile to build with Java 23 if your environment supports Lombok on JDK 23 -->
        <profile>
            <id>java-23</id>
            <activation>
                <property>
                    <name>java-23</name>
                </property>
            </activation>
            <properties>
                <java.version>23</java.version>
            </properties>
        </profile>
        <!-- New optional profile: enable toolchains only when explicitly requested -->
        <profile>
            <id>use-toolchains</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-toolchains-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>toolchain</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <toolchains>
                                <jdk>
                                    <version>${java.version}</version>
                                </jdk>
                            </toolchains>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
