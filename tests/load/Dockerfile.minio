# MinIO community prebuilt images are no longer distributed. Build the
# upstream source release for this isolated local environment.
FROM golang:1.24-alpine AS build
RUN apk add --no-cache git
RUN CGO_ENABLED=0 go install github.com/minio/minio@RELEASE.2025-04-22T22-12-26Z
FROM alpine:3.22
RUN apk add --no-cache ca-certificates curl && adduser -D -u 1000 minio
COPY --from=build /go/bin/minio /usr/local/bin/minio
RUN mkdir /data && chown minio /data
USER minio
ENTRYPOINT ["minio"]
