<mxCell id="tier455" value="Services and messaging" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=2;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="100" height="30" as="geometry"/></mxCell>
<mxCell id="tier745" value="Data" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontStyle=2;fontColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="730" width="100" height="30" as="geometry"/></mxCell>
<mxCell id="user" value="&lt;b&gt;Buyer, seller, administrator&lt;/b&gt;&lt;br&gt;Web browser" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="30" width="380" height="60" as="geometry"/></mxCell>
<mxCell id="cdn" value="&lt;b&gt;CloudFront and S3&lt;/b&gt;&lt;br&gt;Serves the Vue.js web app; forwards /api/* and /ws/*" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="130" width="380" height="60" as="geometry"/></mxCell>
<mxCell id="alb" value="&lt;b&gt;Application Load Balancer&lt;/b&gt;&lt;br&gt;Routes each request by path to one service" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="240" width="1360" height="50" as="geometry"/></mxCell>
<mxCell id="search" value="&lt;b&gt;Search service&lt;/b&gt;&lt;br&gt;Keyword search, filters, highlighting&lt;br&gt;Builds its index from listing events&lt;br&gt;Rebuilds it from the listing table" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="370" width="260" height="170" as="geometry"/></mxCell>
<mxCell id="mqp" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;br&gt;product.exchange (topic)&lt;br&gt;created, updated, deleted&lt;br&gt;Search: one active consumer&lt;br&gt;delisted: also to Chat" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="430" y="405" width="200" height="135" as="geometry"/></mxCell>
<mxCell id="core" value="&lt;b&gt;Core service&lt;/b&gt;&lt;br&gt;Users and access; listings and media&lt;br&gt;Cart, orders and payment; bargaining&lt;br&gt;Reviews and credit score; favourites&lt;br&gt;Recommendations; reports and administration" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="370" width="380" height="170" as="geometry"/></mxCell>
<mxCell id="chat" value="&lt;b&gt;Chat service&lt;/b&gt;&lt;br&gt;Chat, system messages, broadcasts&lt;br&gt;WebSocket (STOMP); chat history&lt;br&gt;Delisting notices, from events&lt;br&gt;One or more instances" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1230" y="370" width="260" height="170" as="geometry"/></mxCell>
<mxCell id="mqc" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;br&gt;chat.fanout.exchange&lt;br&gt;One private queue per instance&lt;br&gt;Every instance receives each message" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1530" y="400" width="230" height="110" as="geometry"/></mxCell>
<mxCell id="os" value="&lt;b&gt;OpenSearch&lt;/b&gt;&lt;br&gt;Listing index&lt;br&gt;Derived from listing events" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="640" width="200" height="100" as="geometry"/></mxCell>
<mxCell id="s3" value="&lt;b&gt;S3&lt;/b&gt;&lt;br&gt;Listing media" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="670" y="640" width="130" height="100" as="geometry"/></mxCell>
<mxCell id="redis" value="&lt;b&gt;Redis&lt;/b&gt;&lt;br&gt;Recommendations&lt;br&gt;Browsing history&lt;br&gt;Locks" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="820" y="640" width="130" height="100" as="geometry"/></mxCell>
<mxCell id="mysql" value="&lt;b&gt;MySQL (one schema, one user per service)&lt;/b&gt;&lt;br&gt;Core: every table except chat_message.    Chat: chat_message; user tables read-only.    Search: listing table read-only." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="780" width="1360" height="70" as="geometry"/></mxCell>
