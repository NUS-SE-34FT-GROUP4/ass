<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="sg.edu.nus.iss.c2csectrade.mapper.OrderItemMapper">
    <insert id="insert">
        INSERT INTO order_items (order_id, product_id, quantity, price, from_cart)
        VALUES (#{orderId}, #{productId}, #{quantity}, #{price}, #{fromCart})
    </insert>

    <select id="findByOrderId" resultType="sg.edu.nus.iss.c2csectrade.entity.OrderItem">
        SELECT * FROM order_items WHERE order_id = #{orderId}
    </select>
</mapper>
